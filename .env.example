APP_NAME=Kaizen Student Portal
APP_VERSION=1.0.0
APP_ENV=development
SECRET_KEY=change-this-for-production
LOG_LEVEL=INFO
PORT=8000

# Local development defaults to SQLite when DB_HOST is empty.
# For Amazon RDS MySQL, set DB_HOST and the other DB_* variables.
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_NAME=student_portal
DB_USER=portal_app
DB_PASSWORD=change-me

# Use "local" while developing and "s3" on EC2.
STORAGE_BACKEND=local
S3_BUCKET_NAME=
AWS_REGION=us-east-1
S3_PREFIX=resumes

MAX_UPLOAD_MB=5
